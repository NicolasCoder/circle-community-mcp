# ==============================================================================
# Circle Community MCP — Configuração de Ambiente (Opcional)
# ==============================================================================
# O Circle Community MCP já funciona automaticamente com as portas e diretórios
# padrão abaixo. Copie este arquivo para `.env` apenas se quiser customizar.

# URL principal da comunidade Circle.so
CIRCLE_COMMUNITY_ORIGIN=https://engenheiros-de-video.circle.so

# Porta isolada do Google Chrome CDP (Padrão: 9363 — 100% livre de conflito com 9333/9343/9353)
CIRCLE_CHROME_PORT=9363

# Porta do Daemon HTTP / Fila Central SQLite (Padrão: 9364)
CIRCLE_DAEMON_PORT=9364

# Pasta do perfil isolado do Chrome onde a sessão autenticada do Circle.so fica salva
# Windows padrão: C:\circle-mcp-profile | macOS/Linux padrão: ~/.circle-mcp-profile
CIRCLE_PROFILE_DIR=C:\circle-mcp-profile

# Caminho opcional do executável do Google Chrome (detectado automaticamente se vazio)
CIRCLE_CHROME_EXE=
